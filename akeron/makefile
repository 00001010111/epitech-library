##
## EPITECH PROJECT, 2025
## Makefile
## File description:
## Optimized libmy Makefile with automatic akeron sources
##

NAME        =   libakeron.a

SRC_DIR     =   .
BIN_DIR     =   .bin
INC_DIR     =   ../include

CC          =   epiclang
CFLAGS      =   -I$(INC_DIR) -MMD -MP

# Recursive source detection
SRC         =   $(shell find $(SRC_DIR) -name "*.c")

# Object files mirror folder structure
OBJ         =   $(SRC:$(SRC_DIR)/%.c=$(BIN_DIR)/%.o)
DEP         =   $(OBJ:.o=.d)

ERROR_LOG   =   lib_build_errors.log

# Colors
RESET       =   \033[0m
BOLD        =   \033[1m
RED         =   \033[31m
GREEN       =   \033[32m
YELLOW      =   \033[33m
BLUE        =   \033[34m
CYAN        =   \033[36m

all: clean_log $(NAME) report

clean_log:
	@rm -f $(ERROR_LOG)

# Compile
$(BIN_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(dir $@)
	@printf "$(BLUE)Compiling lib$(RESET) %-37s" "$<"
	@$(CC) $(CFLAGS) -c $< -o $@ 2>>$(ERROR_LOG) && \
	printf "$(GREEN)[OK]$(RESET)\n" || \
	(printf "$(RED)[FAIL]$(RESET)\n" && exit 1)

# Archive
$(NAME): $(OBJ)
	@printf "$(CYAN)📦 Creating library $(BOLD)$(NAME)$(RESET)\n"
	@ar rcs $(NAME) $(OBJ)

# Report
report:
	@touch $(BIN_DIR)/.gitignore && echo -e "This file is autogenerated by Akeron lib.\n*" >> $(BIN_DIR)/.gitignore
	@if [ -f $(ERROR_LOG) ]; then \
		ERRS=$$(grep -ic "error:" $(ERROR_LOG) || true); \
		WARNS=$$(grep -ic "warning:" $(ERROR_LOG) || true); \
		if [ "$$ERRS" -gt 0 ] || [ "$$WARNS" -gt 0 ]; then \
			printf "$(BOLD)Lib Status:$(RESET)\n"; \
			[ "$$ERRS" -gt 0 ] && printf "  $(RED)✖ Errors:   $$ERRS$(RESET)\n" || true; \
			[ "$$WARNS" -gt 0 ] && printf "  $(YELLOW)⚠ Warnings: $$WARNS$(RESET)\n" || true; \
		else \
			printf "$(GREEN)✔ Library built cleanly.$(RESET)\n"; \
		fi; \
	fi

clean:
	@printf "$(YELLOW)🧹 Cleaning object files$(RESET)\n"
	@rm -rf $(BIN_DIR)

fclean: clean
	@printf "$(RED)🗑 Removing $(NAME)$(RESET)\n"
	@rm -f $(NAME)
	@rm -f $(ERROR_LOG)

re: fclean all

-include $(DEP)

.PHONY: all clean fclean re clean_log report